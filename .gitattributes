# Normalize line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Windows scripts must keep CRLF to be runnable.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts and the Maven wrapper must keep LF.
*.sh text eol=lf
mvnw text eol=lf

# Binary files are never converted.
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.woff2 binary

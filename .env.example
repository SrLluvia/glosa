# Copy to .env and replace every value. .env is gitignored and never committed.

# --- Postgres ---------------------------------------------------------------
# Owner role. Used only by Flyway, which needs schema privileges.
POSTGRES_DB=glosa
POSTGRES_USER=glosa_owner
POSTGRES_PASSWORD=replace-me-owner-password
POSTGRES_PORT=5432

# Least-privileged role used by the running service. Row Level Security is
# enforced against it, so it must never be the owner or a superuser.
APP_DB_USER=glosa_app
APP_DB_PASSWORD=replace-me-app-password

# --- Ollama -----------------------------------------------------------------
OLLAMA_PORT=11434

# --- Core service -----------------------------------------------------------
# Signing key for the access tokens the service issues. At least 32 bytes.
# Generate one with: openssl rand -base64 48
GLOSA_JWT_SECRET=replace-me-with-a-generated-secret

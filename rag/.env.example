# Copy to .env for local runs outside Docker. Values here are defaults, not secrets.

# Where Ollama is reachable. Inside Docker Compose this is http://ollama:11434.
GLOSA_RAG_OLLAMA_URL=http://localhost:11434

# Produces 768-dimensional vectors, which is what the chunk.embedding column
# is declared as. Changing the model means changing that column too.
GLOSA_RAG_EMBEDDING_MODEL=nomic-embed-text

GLOSA_RAG_CHAT_MODEL=llama3.2:3b
